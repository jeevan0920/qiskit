FROM python:3.12-slim

WORKDIR /workspace

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    rustc \
    cargo \
    git \
    vim \
    curl \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy source code
COPY . .

# Set environment
ENV QISKIT_BUILD_PROFILE=release
ENV RUST_BACKTRACE=1
ENV PYTHONUNBUFFERED=1

# Install Python build dependencies and core packages
RUN pip install --upgrade pip setuptools wheel && \
    pip install setuptools-rust && \
    pip install -e . && \
    pip install tox pytest pytest-cov 2>/dev/null || true

# Default command
CMD ["/bin/bash"]
